# Chave da API OpenAI (ou compatível)
OPENAI_API_KEY=sk-your-api-key-here

# URL base alternativa (Ollama, Azure, etc.)
# LLM_API_BASE=http://localhost:11434/v1

# URLs base que o cliente pode enviar em /search (separadas por vírgula).
# Padrão: Groq, OpenAI, Gemini e Anthropic. Vazio recusa qualquer api_base do cliente.
# LLM_API_BASE_ALLOWLIST=https://api.groq.com/openai/v1,https://api.openai.com/v1

# Caminho do banco DuckDB
DB_PATH=data/datasus.db

# Logging
LOG_LEVEL=INFO
