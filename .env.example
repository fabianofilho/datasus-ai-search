# Configuração da API do LLM
# Para OpenAI
OPENAI_API_KEY=sk-your-api-key-here

# Para usar um LLM alternativo (ex: Ollama local)
# LLM_API_BASE=http://localhost:8000/v1
# LLM_MODEL=gpt-4.1-mini

# URLs base que o cliente da API pode enviar em /search (separadas por vírgula).
# Padrão: Groq, OpenAI, Gemini e Anthropic (endpoints compatíveis com a OpenAI).
# Com api_base do cliente, a api_key também precisa vir na requisição.
# Defina vazio para recusar qualquer api_base enviado pelo cliente.
# LLM_API_BASE_ALLOWLIST=https://api.groq.com/openai/v1,https://api.openai.com/v1

# Configuração do banco de dados
DB_PATH=data/datasus.db

# Máximo de combinações UF x ano por pedido ao /init-db (padrão 9: uma região em um ano).
# INIT_DB_MAX_UF_ANO=9

# Logging
LOG_LEVEL=INFO
